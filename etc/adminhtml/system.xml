        <!--
            Adds a PayMongo entry to the stock Stores > Configuration > Sales > Payment
            Methods grid (section "payment", owned by Magento_Payment) — merchants
            browsing that classic list (rather than the dedicated "PayMongo" tab in the
            left nav) would otherwise see no mention of PayMongo there at all. Shows a
            small redirect notice instead of duplicating every field here, the same
            pattern Mollie's own module uses for its entry on that same page.
        -->
        <section id="payment">
            <group id="paymongo" translate="label" type="text" sortOrder="101"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>PayMongo</label>
                <!--
                    frontend_model lives on this nested group, not "paymongo" itself, so
                    "PayMongo" still renders as a normal labeled, collapsible row on the
                    page — matching every sibling entry (Check/Money Order, Bank Transfer,
                    etc.) — with the redirect notice as its expandable content, rather than
                    replacing the whole row's rendering and losing that label/collapse
                    behavior (a group-level frontend_model replaces everything, header
                    included — see Block\Adminhtml\System\Config\Form\PaymentMethodRow for
                    where that's actually wanted, elsewhere in this module).
                -->
                <group id="notice" translate="label" type="text" sortOrder="0"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Branding</label>
                    <frontend_model>PayMongo\Payment\Block\Adminhtml\Render\PaymentMethodsRedirectNotice</frontend_model>
                </group>
            </group>
        </section>
    </system>
