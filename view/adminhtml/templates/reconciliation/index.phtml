                <div class="paymongo-table-scroll">
                    <table class="paymongo-table">
                        <thead>
                            <tr>
                                <th><?= $escaper->escapeHtml(__('ID')) ?></th>
                                <th><?= $escaper->escapeHtml(__('Status')) ?></th>
                                <th><?= $escaper->escapeHtml(__('Amount')) ?></th>
                                <th><?= $escaper->escapeHtml(__('Payment ID')) ?></th>
                                <th><?= $escaper->escapeHtml(__('Reason')) ?></th>
                                <th><?= $escaper->escapeHtml(__('Created')) ?></th>
                            </tr>
                        </thead>
